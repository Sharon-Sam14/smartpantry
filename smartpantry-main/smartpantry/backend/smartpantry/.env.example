# ============================================================
# SmartPantry Backend — Email (SMTP) configuration
# ------------------------------------------------------------
# Copy this file to ".env" (same folder as manage.py) and fill
# in real values. Django auto-loads it on startup.
# ============================================================

# ---- Gmail (recommended, free) ----
# 1. Enable 2-Step Verification on your Google account:
#       https://myaccount.google.com/security
# 2. Create an "App password":
#       https://myaccount.google.com/apppasswords
#    -> App: Mail   |   Device: Other ("SmartPantry")
#    -> Copy the 16-character password Google gives you
# 3. Paste it below (no spaces).

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL=SmartPantry <youraddress@gmail.com>

# ---- Alternatives ----
# Outlook / Office365:
#   EMAIL_HOST=smtp.office365.com   EMAIL_PORT=587   EMAIL_USE_TLS=True
# SendGrid:
#   EMAIL_HOST=smtp.sendgrid.net    EMAIL_PORT=587   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=apikey          EMAIL_HOST_PASSWORD=<your SendGrid API key>
# Brevo (Sendinblue):
#   EMAIL_HOST=smtp-relay.brevo.com EMAIL_PORT=587   EMAIL_USE_TLS=True

# ---- Django ----
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
